{
  "id": "shop-order-create",
  "contract": "shop",
  "operationId": "createOrder",
  "input": "order-request",
  "output": "order-confirmation",
  "target": { "connection": "shop", "method": "POST", "path": "/shop/v1/orders" },
  "request": { "links": [
    { "from": "so-ref", "to": "body.externalRef" },
    { "from": "so-first", "to": "body.customer.name.first" },
    { "from": "so-last", "to": "body.customer.name.last" },
    { "from": "so-email", "to": "body.customer.contact.email" },
    { "from": "so-phone", "to": "body.customer.contact.phone" },
    { "from": "so-vip", "to": "body.customer.vip" },
    { "from": "so-currency", "to": "body.currency" },
    { "from": "so-date", "to": "body.orderDate" },
    { "from": "so-notes", "to": "body.comment" },
    { "from": "so-channel", "to": "body.channel" },
    { "from": "so-tags", "to": "body.labels[]" },
    { "from": "so-lines", "to": "body.items[]" },
    { "from": "so-sku", "to": "body.items[].product.sku" },
    { "from": "so-name", "to": "body.items[].product.name" },
    { "from": "so-qty", "to": "body.items[].quantity" },
    { "from": "so-price", "to": "body.items[].unitPrice" },
    { "from": "so-country", "to": "body.items[].shipCountry" },
    { "from": "so-currency", "to": "body.items[].currency" },
    { "from": "so-options", "to": "body.items[].attributes[]" },
    { "from": "so-opt-code", "to": "body.items[].attributes[].key" },
    { "from": "so-opt-value", "to": "body.items[].attributes[].val" },
    { "from": "so-sku", "to": "body.items[].attributes[].sku" }
  ] },
  "response": { "links": [
    { "from": "orderId", "to": "oc-orderId" },
    { "from": "status", "to": "oc-status" },
    { "from": "received.customer.contact.email", "to": "oc-email" },
    { "from": "received.customer.vip", "to": "oc-vip" },
    { "from": "received.channel", "to": "oc-channel" },
    { "from": "received.comment", "to": "oc-notes" },
    { "from": "received.labels[]", "to": "oc-tags" },
    { "from": "received.items[]", "to": "oc-lines" },
    { "from": "received.items[].product.sku", "to": "oc-sku" },
    { "from": "received.items[].quantity", "to": "oc-qty" },
    { "from": "received.items[].unitPrice", "to": "oc-price" },
    { "from": "received.items[].shipCountry", "to": "oc-country" },
    { "from": "received.items[].attributes[]", "to": "oc-attrs" },
    { "from": "received.items[].attributes[].key", "to": "oc-attr-code" },
    { "from": "received.items[].attributes[].val", "to": "oc-attr-value" },
    { "from": "received.items[].attributes[].sku", "to": "oc-attr-sku" }
  ] }
}
