{
  "id": "docs-get-raw",
  "contract": "docs",
  "operationId": "getDocument",
  "input": "document-id",
  "output": "document-file",
  "target": { "connection": "docs", "method": "GET", "path": "/docs/v1/documents/{id}" },
  "formats": { "output": "binary" },
  "request": { "links": [ { "from": "dd-id", "to": "path.id" } ] },
  "response": { "links": [
    { "from": "contentBase64", "to": "df-content.data" },
    { "from": "fileName", "to": "df-content.fileName" },
    { "from": "contentType", "to": "df-content.contentType" }
  ] }
}
