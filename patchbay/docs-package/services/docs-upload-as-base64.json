{
  "id": "docs-upload-as-base64",
  "contract": "docs",
  "operationId": "uploadDocumentBase64",
  "input": "document-upload",
  "output": "document-stored",
  "target": { "connection": "docs", "method": "POST", "path": "/docs/v1/documents/base64" },
  "request": { "links": [
    { "from": "dup-file.fileName", "to": "body.fileName" },
    { "from": "dup-file.contentType", "to": "body.contentType" },
    { "from": "dup-file.data", "to": "body.contentBase64" }
  ] },
  "response": { "links": [
    { "from": "documentId", "to": "ds-id" },
    { "from": "status", "to": "ds-status" },
    { "from": "fileName", "to": "ds-name" }
  ] }
}
