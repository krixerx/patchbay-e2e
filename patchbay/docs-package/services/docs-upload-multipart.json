{
  "id": "docs-upload-multipart",
  "contract": "docs",
  "operationId": "uploadDocument",
  "input": "document-upload",
  "output": "document-stored",
  "target": { "connection": "docs", "method": "POST", "path": "/docs/v1/documents" },
  "formats": { "request": "multipart" },
  "request": { "links": [
    { "from": "dup-title", "to": "body.title" },
    { "from": "dup-file", "to": "body.file" }
  ] },
  "response": { "links": [
    { "from": "documentId", "to": "ds-id" },
    { "from": "status", "to": "ds-status" },
    { "from": "title", "to": "ds-title" }
  ] }
}
