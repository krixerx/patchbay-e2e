<?xml version="1.0" encoding="UTF-8"?>
<!-- Imported by registry.wsdl by a relative location, so Patchbay fetches it from the mock too (D-30). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:example:common" elementFormDefault="qualified">
  <xs:complexType name="Address">
    <xs:sequence>
      <xs:element name="street" type="xs:string"/>
      <xs:element name="city" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
