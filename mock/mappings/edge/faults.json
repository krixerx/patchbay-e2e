{
  "mappings": [
    {
      "name": "edge: answers after 5 s (Patchbay's test timeout is 2 s)",
      "request": { "method": "GET", "urlPath": "/edge/slow" },
      "response": { "status": 200, "fixedDelayMilliseconds": 5000, "headers": { "Content-Type": "application/json" }, "jsonBody": { "ok": true } }
    },
    {
      "name": "edge: answers after 0.5 s (inside the timeout)",
      "request": { "method": "GET", "urlPath": "/edge/sluggish" },
      "response": { "status": 200, "fixedDelayMilliseconds": 500, "headers": { "Content-Type": "application/json" }, "jsonBody": { "ok": true } }
    },
    {
      "name": "edge: connection reset",
      "request": { "method": "GET", "urlPath": "/edge/reset" },
      "response": { "fault": "CONNECTION_RESET_BY_PEER" }
    },
    {
      "name": "edge: connection closed without a response",
      "request": { "method": "GET", "urlPath": "/edge/empty" },
      "response": { "fault": "EMPTY_RESPONSE" }
    },
    {
      "name": "edge: garbage bytes, then closed",
      "request": { "method": "GET", "urlPath": "/edge/garbage" },
      "response": { "fault": "RANDOM_DATA_THEN_CLOSE" }
    },
    {
      "name": "edge: 200 with a body that is not JSON",
      "request": { "method": "GET", "urlPath": "/edge/malformed" },
      "response": { "status": 200, "headers": { "Content-Type": "application/json" }, "body": "{\"ok\": tru" }
    }
  ]
}
