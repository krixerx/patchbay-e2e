{
  "mappings": [
    {
      "name": "docs: upload as multipart/form-data (parts: title, file)",
      "request": {
        "method": "POST",
        "urlPath": "/docs/v1/documents",
        "headers": { "Content-Type": { "contains": "multipart/form-data" } },
        "multipartPatterns": [
          { "matchingType": "ANY", "headers": { "Content-Disposition": { "contains": "name=\"file\"" } } }
        ]
      },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"documentId\":\"DOC-2\",\"status\":\"STORED\",\"title\":\"{{request.parts.title.body}}\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "docs: upload without a file part",
      "priority": 9,
      "request": { "method": "POST", "urlPath": "/docs/v1/documents" },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "send multipart/form-data with a file part" }
      }
    },
    {
      "name": "docs: upload a document as JSON with base64 content",
      "request": {
        "method": "POST",
        "urlPath": "/docs/v1/documents/base64",
        "headers": { "Content-Type": { "contains": "application/json" } }
      },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"documentId\":\"DOC-3\",\"status\":\"STORED\",\"fileName\":\"{{jsonPath request.body '$.fileName'}}\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "docs: replace the content with raw bytes",
      "request": {
        "method": "PUT",
        "urlPathTemplate": "/docs/v1/documents/{id}/content",
        "headers": { "Content-Type": { "matches": "application/(pdf|octet-stream).*" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"documentId\":\"{{request.path.id}}\",\"status\":\"STORED\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "docs: metadata with the content as base64",
      "request": { "method": "GET", "urlPath": "/docs/v1/documents/DOC-1" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "docs/document-DOC-1.json"
      }
    },
    {
      "name": "docs: download the PDF",
      "request": { "method": "GET", "urlPath": "/docs/v1/documents/DOC-1/content" },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/pdf",
          "Content-Disposition": "attachment; filename=\"sample.pdf\""
        },
        "bodyFileName": "docs/sample.pdf"
      }
    },
    {
      "name": "docs: download 1 MiB of binary",
      "request": { "method": "GET", "urlPath": "/docs/v1/documents/DOC-LARGE/content" },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/octet-stream",
          "Content-Disposition": "attachment; filename=\"large.bin\""
        },
        "bodyFileName": "docs/large.bin"
      }
    }
  ]
}
