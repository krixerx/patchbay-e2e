{
  "mappings": [
    {
      "name": "users: any call without the right bearer token",
      "priority": 9,
      "request": { "urlPathPattern": "/public/v2/users.*" },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "jsonBody": { "message": "Authentication failed" }
      }
    },
    {
      "name": "users: create",
      "request": {
        "method": "POST",
        "urlPath": "/public/v2/users",
        "headers": { "Authorization": { "equalTo": "Bearer gorest-test-token" } }
      },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "body": "{\"id\":7001,\"name\":\"{{jsonPath request.body '$.name'}}\",\"email\":\"{{jsonPath request.body '$.email'}}\",\"gender\":\"{{jsonPath request.body '$.gender'}}\",\"status\":\"{{jsonPath request.body '$.status'}}\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "users: create with an email that is taken",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/public/v2/users",
        "headers": { "Authorization": { "equalTo": "Bearer gorest-test-token" } },
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.email == 'taken@example.com')]" }]
      },
      "response": {
        "status": 422,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "jsonBody": [{ "field": "email", "message": "has already been taken" }]
      }
    },
    {
      "name": "users: search (public, no token needed)",
      "priority": 5,
      "request": { "method": "GET", "urlPath": "/public/v2/users" },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8",
          "X-Pagination-Total": "3"
        },
        "bodyFileName": "users/users.json"
      }
    },
    {
      "name": "users: update",
      "request": {
        "method": "PUT",
        "urlPathTemplate": "/public/v2/users/{id}",
        "headers": { "Authorization": { "equalTo": "Bearer gorest-test-token" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "body": "{\"id\":{{request.path.id}},\"user\":{{{request.body}}} }",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "users: delete (204 without a body)",
      "priority": 5,
      "request": { "method": "DELETE", "urlPathTemplate": "/public/v2/users/{id}" },
      "response": { "status": 204 }
    }
  ]
}
